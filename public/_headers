# Cloudflare Workers static assets: nagłówki dla plików serwowanych bezpośrednio z dist/client.

/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Pliki Vite mają hash w nazwie, więc mogą być cache'owane na stałe.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonty mają stałe nazwy: długi cache, ale bez immutable.
/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
