{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Custom Domain: Cloudflare sam tworzy rekord DNS i certyfikat w strefie piotrwrotny.pl.
  "name": "piotrwrotny-com",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "piotrwrotny.pl", "custom_domain": true },
    { "pattern": "www.piotrwrotny.pl", "custom_domain": true }
  ],
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "observability": { "enabled": true }
}
